# Bachega Environment Configuration

# CoinGecko Demo or Pro API Key (Optional: fallbacks active if omitted)
COINGECKO_API_KEY=

# Alchemy API Key for on-chain balances (Optional: fallback data active if omitted)
ALCHEMY_API_KEY=
ALCHEMY_ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=@Bachega_bot

# Supabase Auth & Storage
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# API Server Configuration
BACKEND_URL=http://localhost:8000
PORT=8000
